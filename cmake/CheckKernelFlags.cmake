# The CPU test's kernel TUs really get P7's flags (Phase 2 design §6.2,
# §14.2 item 4): read from compile_commands.json, as the compiler sees them,
# so a later flag that overrides one (a build type's -O3, /Od) is caught.
#   cmake -DCOMMANDS=<build>/compile_commands.json -DCOMPILER=<GNU|Clang|MSVC>
#         [-DSCALAR=<file>|<file>...] [-DWIDE=<file>=<flag>,<flag>|...] [-DPLAIN=<file>|...]
#         -P CheckKernelFlags.cmake
# SCALAR: -O2 / /O2 (the last optimisation level wins), no auto-vectorisation
# (GCC -fno-tree-vectorize, Clang -fno-vectorize -fno-slp-vectorize), no FP
# contraction (-ffp-contract=off; MSVC /fp:precise plus the TU's pragma), no
# LTO (-flto, /GL), no MSVC run-time checks (/RTC*).
# WIDE: the same optimisation and LTO rules, plus each listed arch flag.
# PLAIN: the optimisation and LTO rules only (the RAM test's kernels, Phase 3
# design §1, §9: integer-only, so no FP or vectorisation rules).
# Run with cmake -P: the policies of the project's minimum (a script gets
# none from the project, and CMake 3.x would run it with OLD ones).
cmake_minimum_required(VERSION 3.25)

file(READ "${COMMANDS}" json)
string(JSON entries LENGTH "${json}")
math(EXPR last "${entries} - 1")
set(commands "")
set(files "")
foreach(i RANGE ${last})
    string(JSON f GET "${json}" ${i} file)
    file(TO_CMAKE_PATH "${f}" f)
    string(JSON c ERROR_VARIABLE no_command GET "${json}" ${i} command)
    if(no_command)
        # The "arguments" form: an array.
        string(JSON n LENGTH "${json}" ${i} arguments)
        math(EXPR nlast "${n} - 1")
        set(c "")
        foreach(a RANGE ${nlast})
            string(JSON arg GET "${json}" ${i} arguments ${a})
            string(APPEND c " ${arg}")
        endforeach()
    endif()
    list(APPEND files "${f}")
    # One string per file; ";" can't appear in a compile command we check.
    string(REPLACE ";" " " c "${c}")
    list(APPEND commands "${c}")
endforeach()

# The last token of `command` matching `regex` (empty if none) into `out`.
function(last_match command regex out)
    string(REGEX MATCHALL "(^| )(${regex})" all " ${command}")
    set(value "")
    if(all)
        list(GET all -1 value)
        string(STRIP "${value}" value)
    endif()
    set(${out} "${value}" PARENT_SCOPE)
endfunction()

set(problems "")
function(check_file file wide_flags)
    set(scalar_rules ON)
    if(wide_flags OR (ARGC GREATER 2 AND ARGV2 STREQUAL "PLAIN"))
        set(scalar_rules OFF)
    endif()
    file(TO_CMAKE_PATH "${file}" want)
    list(FIND files "${want}" at)
    if(at EQUAL -1)
        set(problems "${problems};${file}: not in ${COMMANDS}" PARENT_SCOPE)
        return()
    endif()
    list(GET commands ${at} cmd)
    set(bad "")
    if(COMPILER STREQUAL "MSVC")
        last_match("${cmd}" "[/-]O[12dx]" opt)
        if(NOT opt MATCHES "^[/-]O2$")
            list(APPEND bad "optimisation is '${opt}', not /O2")
        endif()
        last_match("${cmd}" "[/-]Ob[0-3]" inl)
        if(inl MATCHES "Ob0$")
            list(APPEND bad "inlining is off (${inl})")
        endif()
        if(cmd MATCHES "[ /-]RTC[1csu]")
            list(APPEND bad "has run-time checks (/RTC)")
        endif()
        if(cmd MATCHES "[ /-]GL( |$)")
            list(APPEND bad "has /GL (whole-program optimisation)")
        endif()
        if(scalar_rules)
            last_match("${cmd}" "[/-]fp:[a-z]+" fp)
            if(NOT fp MATCHES "fp:precise$")
                list(APPEND bad "floating-point model is '${fp}', not /fp:precise")
            endif()
        endif()
    else()
        last_match("${cmd}" "-O[0-3sgz]?" opt)
        if(NOT opt STREQUAL "-O2")
            list(APPEND bad "optimisation is '${opt}', not -O2")
        endif()
        if(cmd MATCHES " -flto")
            list(APPEND bad "has -flto")
        endif()
        if(scalar_rules)
            last_match("${cmd}" "-ffp-contract=[a-z]+" contract)
            if(NOT contract STREQUAL "-ffp-contract=off")
                list(APPEND bad "FP contraction is '${contract}', not -ffp-contract=off")
            endif()
            if(COMPILER STREQUAL "Clang")
                foreach(pair "vectorize" "slp-vectorize")
                    last_match("${cmd}" "-f(no-)?${pair}" v)
                    if(NOT v STREQUAL "-fno-${pair}")
                        list(APPEND bad "auto-vectorisation: '${v}', not -fno-${pair}")
                    endif()
                endforeach()
            else()
                last_match("${cmd}" "-f(no-)?tree-vectorize" v)
                if(NOT v STREQUAL "-fno-tree-vectorize")
                    list(APPEND bad "auto-vectorisation: '${v}', not -fno-tree-vectorize")
                endif()
                foreach(sub loop slp)
                    last_match("${cmd}" "-ftree-${sub}-vectorize" v)
                    if(v)
                        list(APPEND bad "re-enables ${v}")
                    endif()
                endforeach()
            endif()
        endif()
    endif()
    foreach(flag IN LISTS wide_flags)
        string(REGEX REPLACE "([][+.*?()^$\\\\|])" "\\\\\\1" escaped "${flag}")
        if(NOT " ${cmd} " MATCHES " ${escaped} ")
            list(APPEND bad "lacks ${flag}")
        endif()
    endforeach()
    if(bad)
        list(JOIN bad "; " bad)
        set(problems "${problems};${file}: ${bad}" PARENT_SCOPE)
    else()
        message(STATUS "ok  ${file}")
    endif()
endfunction()

string(REPLACE "|" ";" scalar "${SCALAR}")
foreach(f IN LISTS scalar)
    check_file("${f}" "")
endforeach()
string(REPLACE "|" ";" plain "${PLAIN}")
foreach(f IN LISTS plain)
    check_file("${f}" "" PLAIN)
endforeach()
if(WIDE)
    string(REPLACE "|" ";" wide "${WIDE}")
    foreach(entry IN LISTS wide)
        string(REGEX MATCH "^(.*)=([^=]*)$" _m "${entry}")
        string(REPLACE "," ";" flags "${CMAKE_MATCH_2}")
        check_file("${CMAKE_MATCH_1}" "${flags}")
    endforeach()
endif()

list(REMOVE_ITEM problems "")
if(problems)
    list(JOIN problems "\n  " problems)
    message(FATAL_ERROR "Kernel TUs without P7's flags:\n  ${problems}")
endif()
