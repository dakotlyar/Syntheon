# A binary file as a C++ include (Phase 4a design §13.1: the DXIL and DXBC
# the Windows build compiles for the GPU worker):
#   static const unsigned char <NAME>[] = {...};
#   static const std::size_t <NAME>Size = <bytes>;
# The includer brings <cstddef>.
#   cmake -DINPUT=<file> -DOUTPUT=<file.inc> -DNAME=<kName> -P EmbedBinary.cmake
# Run with cmake -P: the policies of the project's minimum (a script gets
# none from the project).
cmake_minimum_required(VERSION 3.25)
foreach(var INPUT OUTPUT NAME)
    if(NOT ${var})
        message(FATAL_ERROR "EmbedBinary.cmake: -D${var}=... is required")
    endif()
endforeach()
file(SIZE "${INPUT}" size)
if(size EQUAL 0)
    message(FATAL_ERROR "EmbedBinary.cmake: ${INPUT} is empty")
endif()
file(READ "${INPUT}" hex HEX)
# 16 bytes per line: split the hex into 32-digit lines, then each pair into 0xNN.
# (CMake's regex has no {n}: 32 copies of the digit class.)
string(REPEAT "[0-9a-f]" 32 line)
string(REGEX REPLACE "(${line})" "\\1\n" hex "${hex}")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1, " hex "${hex}")
string(REGEX REPLACE ", \n" ",\n    " hex "${hex}")
string(REGEX REPLACE "[ \n]+$" "" hex "${hex}")
get_filename_component(source "${INPUT}" NAME)
file(WRITE "${OUTPUT}"
    "// GENERATED by cmake/EmbedBinary.cmake from ${source}; do not edit.\n"
    "static const unsigned char ${NAME}[] = {\n    ${hex}\n};\n"
    "static const std::size_t ${NAME}Size = ${size};\n")
