<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later
     SynBench MSI (WiX v5, D9/D12). Built per architecture:
       wix build -arch x64|arm64 -d Version=26.11.0 -d SourceDir=<stage> -d Arch=x64|arm64 -d IconPath=<repo>\assets\synbench.ico -d UpgradeCode={...}
                 -o SynBench-<ver>-windows-<arch>.msi packaging\windows\wix\Package.wxs
     Version is the MSI form of the app version (26.11.N: MSI's first field is
     limited to 255, so the year is YY). Each architecture has its own stable UpgradeCode,
     so an upgrade replaces only its own. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="SynBench" Manufacturer="SynBench" Version="$(Version)" UpgradeCode="$(UpgradeCode)"
           Scope="perMachine" Language="1033" InstallerVersion="500">
    <SummaryInformation Description="SynBench" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of SynBench is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Icon Id="SynBenchIcon" SourceFile="$(IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="SynBenchIcon" />

    <!-- Inno and the MSI must not both own an install (each writes this value). -->
    <Property Id="INNOINSTALLED">
      <RegistrySearch Id="InnoOwner" Root="HKLM" Key="Software\SynBench" Name="Installer" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="INNOINSTALLED &lt;&gt; &quot;inno&quot;"
            Message="SynBench was installed with the setup program. Uninstall it first (Settings &gt; Apps), then run this MSI." />

    <!-- One architecture of SynBench per machine: the other architecture's MSI
         (or setup) must be uninstalled first. Each install records its own. -->
    <Property Id="INSTALLEDARCH">
      <RegistrySearch Id="ArchOwner" Root="HKLM" Key="Software\SynBench" Name="Arch" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="NOT INSTALLEDARCH OR INSTALLEDARCH = &quot;$(Arch)&quot;"
            Message="The other architecture of SynBench is installed. Uninstall it first (Settings &gt; Apps), then run this MSI." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="InstallFolder" Name="SynBench" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppStartMenuFolder" Name="SynBench" />
    </StandardDirectory>

    <Feature Id="Main" Title="SynBench" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="OwnerMarker" />
    </Feature>

    <ComponentGroup Id="AppFiles" Directory="InstallFolder">
      <Component Id="MainExe" Bitness="always64">
        <File Id="SynBenchExe" Source="$(SourceDir)\SynBench.exe" KeyPath="yes" />
      </Component>
      <Files Include="$(SourceDir)\**">
        <Exclude Files="$(SourceDir)\SynBench.exe" />
      </Files>
    </ComponentGroup>

    <Component Id="StartMenuShortcut" Directory="AppStartMenuFolder" Bitness="always64">
      <Shortcut Id="SynBenchShortcut" Name="SynBench" Target="[InstallFolder]SynBench.exe" WorkingDirectory="InstallFolder" />
      <RemoveFolder Id="RemoveStartMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\SynBench" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="OwnerMarker" Directory="InstallFolder" Bitness="always64">
      <RegistryValue Root="HKLM" Key="Software\SynBench" Name="Installer" Type="string" Value="msi" KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="Software\SynBench" Name="Arch" Type="string" Value="$(Arch)" />
    </Component>
  </Package>
</Wix>
