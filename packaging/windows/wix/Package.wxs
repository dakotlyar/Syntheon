<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later
     Syntheon MSI (WiX v5, D9/D12). Built per architecture:
       wix build -arch x64|arm64 -d Version=0.4.3 -d SourceDir=<stage> -d Arch=x64|arm64 -d IconPath=<repo>\assets\syntheon.ico -d UpgradeCode={...}
                 -o Syntheon-<ver>-windows-<arch>.msi packaging\windows\wix\Package.wxs
     Version is the MSI ProductVersion, the app version itself (X.Y.Z, semver:
     three numeric fields, so it maps straight onto MSI's form). Each architecture has its own stable UpgradeCode,
     so an upgrade replaces only its own.
     Note: the pre-semver 2026.11.x MSIs used CalVer product versions (26.11.1), which sort ABOVE 0.4.3;
     MajorUpgrade won't step over them — uninstall a 2026.11.x install once before installing 0.4.3. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Syntheon" Manufacturer="Syntheon" Version="$(Version)" UpgradeCode="$(UpgradeCode)"
           Scope="perMachine" Language="1033" InstallerVersion="500">
    <SummaryInformation Description="Syntheon" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Syntheon is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Icon Id="SyntheonIcon" SourceFile="$(IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="SyntheonIcon" />

    <!-- Inno and the MSI must not both own an install (each writes this value). -->
    <Property Id="INNOINSTALLED">
      <RegistrySearch Id="InnoOwner" Root="HKLM" Key="Software\SynBench" Name="Installer" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="INNOINSTALLED &lt;&gt; &quot;inno&quot;"
            Message="Syntheon was installed with the setup program. Uninstall it first (Settings &gt; Apps), then run this MSI." />

    <!-- The old Python SynBench (Inno, the shared AppId) is installed: this MSI would
         end up beside it, in the same folder (Dave: refuse). The setup program is the
         one that upgrades it. A v2 setup install also has this key, but is refused
         above with its own message. -->
    <Property Id="OLDPYTHONINNO">
      <RegistrySearch Id="OldPythonInno" Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{14A62E4F-2EF1-40BC-82D9-2418EC833479}_is1"
                      Name="UninstallString" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="NOT OLDPYTHONINNO"
            Message="The old SynBench is installed. Uninstall it first, or use the setup program, which upgrades it." />

    <!-- One architecture of Syntheon per machine: the other architecture's MSI
         (or setup) must be uninstalled first. Each install records its own. -->
    <Property Id="INSTALLEDARCH">
      <RegistrySearch Id="ArchOwner" Root="HKLM" Key="Software\SynBench" Name="Arch" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="NOT INSTALLEDARCH OR INSTALLEDARCH = &quot;$(Arch)&quot;"
            Message="The other architecture of Syntheon is installed. Uninstall it first (Settings &gt; Apps), then run this MSI." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="InstallFolder" Name="Syntheon" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppStartMenuFolder" Name="Syntheon" />
    </StandardDirectory>

    <Feature Id="Main" Title="Syntheon" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="OwnerMarker" />
    </Feature>

    <ComponentGroup Id="AppFiles" Directory="InstallFolder">
      <Component Id="MainExe" Bitness="always64">
        <File Id="SyntheonExe" Source="$(SourceDir)\Syntheon.exe" KeyPath="yes" />
      </Component>
      <Files Include="$(SourceDir)\**">
        <Exclude Files="$(SourceDir)\Syntheon.exe" />
      </Files>
    </ComponentGroup>

    <Component Id="StartMenuShortcut" Directory="AppStartMenuFolder" Bitness="always64">
      <Shortcut Id="SyntheonShortcut" Name="Syntheon" Target="[InstallFolder]Syntheon.exe" WorkingDirectory="InstallFolder" />
      <RemoveFolder Id="RemoveStartMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\SynBench" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="OwnerMarker" Directory="InstallFolder" Bitness="always64">
      <RegistryValue Root="HKLM" Key="Software\SynBench" Name="Installer" Type="string" Value="msi" KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="Software\SynBench" Name="Arch" Type="string" Value="$(Arch)" />
    </Component>
  </Package>
</Wix>
