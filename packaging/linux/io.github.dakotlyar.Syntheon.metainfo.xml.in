<component type="desktop-application">
  <id>io.github.dakotlyar.Syntheon</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Syntheon</name>
  <summary>Synthetic system benchmark</summary>
  <description>
    <p>Syntheon measures CPU, memory, storage, graphics, AI inference and battery life, saves every run on this
    computer and compares runs side by side. It asks for administrator access once, when it starts.</p>
  </description>
  <url type="homepage">https://github.com/dakotlyar/Syntheon</url>
  <url type="bugtracker">https://github.com/dakotlyar/Syntheon/issues</url>
  <developer id="io.github.dakotlyar"><name>Syntheon</name></developer>
  <launchable type="desktop-id">io.github.dakotlyar.Syntheon.desktop</launchable>
  <provides><binary>Syntheon</binary></provides>
  <categories>
    <category>System</category>
    <category>Monitor</category>
  </categories>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@SYNTHEON_VERSION@" date="@SYNTHEON_RELEASE_DATE@"/>
  </releases>
</component>
