// SPDX-License-Identifier: GPL-3.0-or-later
// Generated into the build tree by CMake (cmake/ configure_file); version
// numbers come from the VERSION file.
#include <winver.h>

// The icon with the lowest id is the exe's icon.
1 ICON "@SYNBENCH_SOURCE_DIR@/assets/synbench.ico"

// The manifest (administrator, DPI, long paths) is NOT here: CMake merges and
// embeds it from the target's .manifest source (see CMakeLists.txt). Putting
// it in this file as well gave "CVT1100: duplicate resource MANIFEST 1".

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @SYNBENCH_VERSION_MAJOR@,@SYNBENCH_VERSION_MINOR@,@SYNBENCH_VERSION_PATCH@,0
 PRODUCTVERSION @SYNBENCH_VERSION_MAJOR@,@SYNBENCH_VERSION_MINOR@,@SYNBENCH_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "SynBench"
            VALUE "FileDescription", "SynBench"
            VALUE "FileVersion", "@SYNBENCH_FILE_VERSION@"
            VALUE "InternalName", "SynBench"
            VALUE "LegalCopyright", "GPL-3.0-or-later"
            VALUE "OriginalFilename", "SynBench.exe"
            VALUE "ProductName", "SynBench"
            VALUE "ProductVersion", "@SYNBENCH_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
