{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "SYNBENCH_QT_VERSION": "6.12.0",
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}"
      }
    },
    {
      "name": "linux-x64",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-x64-debug",
      "displayName": "Linux x64 (Debug)",
      "inherits": "linux-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SYNBENCH_DEV_HOOKS": "ON"
      }
    },
    {
      "name": "linux-x64-release",
      "displayName": "Linux x64 (Release)",
      "inherits": "linux-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SYNBENCH_DEV_HOOKS": "ON"
      }
    },
    {
      "name": "windows-x64",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-x64-debug",
      "displayName": "Windows x64 (Debug)",
      "inherits": "windows-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SYNBENCH_DEV_HOOKS": "ON"
      }
    },
    {
      "name": "windows-x64-release",
      "displayName": "Windows x64 (Release)",
      "inherits": "windows-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SYNBENCH_DEV_HOOKS": "ON"
      }
    },
    {
      "name": "linux-x64-package",
      "displayName": "Linux x64 (packaging: no developer hooks, no tests)",
      "inherits": "linux-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SYNBENCH_DEV_HOOKS": "OFF",
        "SYNBENCH_BUILD_TESTS": "OFF",
        "SYNBENCH_RELEASE_BUILD": "ON"
      }
    },
    {
      "name": "windows-x64-package",
      "displayName": "Windows x64 (packaging: no developer hooks, no tests)",
      "inherits": "windows-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SYNBENCH_DEV_HOOKS": "OFF",
        "SYNBENCH_BUILD_TESTS": "OFF",
        "SYNBENCH_RELEASE_BUILD": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-x64-debug",
      "configurePreset": "linux-x64-debug"
    },
    {
      "name": "linux-x64-release",
      "configurePreset": "linux-x64-release"
    },
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64-debug"
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release"
    },
    {
      "name": "linux-x64-package",
      "configurePreset": "linux-x64-package"
    },
    {
      "name": "windows-x64-package",
      "configurePreset": "windows-x64-package"
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "QT_QPA_PLATFORM": "offscreen"
      }
    },
    {
      "name": "linux-x64-debug",
      "inherits": "base",
      "configurePreset": "linux-x64-debug"
    },
    {
      "name": "linux-x64-release",
      "inherits": "base",
      "configurePreset": "linux-x64-release"
    },
    {
      "name": "windows-x64-debug",
      "inherits": "base",
      "configurePreset": "windows-x64-debug"
    },
    {
      "name": "windows-x64-release",
      "inherits": "base",
      "configurePreset": "windows-x64-release"
    }
  ]
}
